<Window x:Class="StockImpulseX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockImpulseX - Контроль сроков годности" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Border x:Name="Overlay" Background="#80000000" Visibility="Collapsed" MouseLeftButtonDown="CloseMenu_Click"/>

        <DockPanel>
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#ddd" BorderThickness="0,0,0,1" Height="60">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button x:Name="BurgerButton" Content="☰" Click="BurgerButton_Click" 
                                Width="35" Height="35" FontSize="20" 
                                Background="Transparent" Foreground="#1a1a1a" 
                                BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"/>
                        <Image Width="45" Height="45" Source="/Images/logoImpulse.png" Margin="0,0,10,0">
                            <Image.Clip>
                                <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,45,45"/>
                            </Image.Clip>
                        </Image>
                        <TextBlock Text="STOCKIMPULSE X" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Ellipse Width="35" Height="35" Fill="#2c2c2c" Stroke="#555" StrokeThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="Profile_Click">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="lblUserName" Text="Магазин №1" FontWeight="Bold" FontSize="14" Foreground="#333"/>
                                <TextBlock x:Name="lblUserRole" Text="Администратор" FontSize="12" Foreground="#666"/>
                            </StackPanel>
                            <TextBlock Text="▼" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#666"/>
                        </StackPanel>

                        <Popup x:Name="ProfilePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=lblUserName}" 
                               StaysOpen="False" PopupAnimation="Fade" AllowsTransparency="True">
                            <Border Background="#2c2c2c" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="0">
                                <StackPanel Width="180">
                                    <Button Content="Настройки" Click="BtnSettings_Click" Background="#2c2c2c" Foreground="#e0e0e0" BorderThickness="0" Padding="15,10" HorizontalContentAlignment="Left" Cursor="Hand"/>
                                    <Button Content="О программе" Click="BtnAbout_Click" Background="#2c2c2c" Foreground="#e0e0e0" BorderThickness="0" Padding="15,10" HorizontalContentAlignment="Left" Cursor="Hand"/>
                                    <Separator Background="#555"/>
                                    <Button Content="Выход" Click="BtnLogout_Click" Background="#2c2c2c" Foreground="#ff8888" BorderThickness="0" Padding="15,10" HorizontalContentAlignment="Left" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1a1a1a">
                        <TextBlock x:Name="PageTitle" Text="Контроль сроков" 
                                   Foreground="White" 
                                   FontSize="23" 
                                   VerticalAlignment="Center" 
                                   Margin="30,0,0,0" 
                                   FontWeight="Bold"/>
                    </Border>

                    <Frame x:Name="MainFrame" 
                           Grid.Row="1" 
                           NavigationUIVisibility="Hidden" 
                           Background="White"/>
                </Grid>
            </Grid>
        </DockPanel>

        <Border x:Name="MenuPanel" Width="220" Background="#1a1a1a" HorizontalAlignment="Left">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MenuTransform" X="-220"/>
            </Border.RenderTransform>
            <StackPanel>
                <TextBlock Text=" навигация    ☰" Foreground="White" FontSize="24" HorizontalAlignment="Center" Margin="0,20,0,20" Cursor="Hand" MouseLeftButtonUp="BurgerButton_Click"/>

                <Button Content="📊 Дашборд" Background="Transparent" Foreground="White" BorderThickness="0" Padding="20,15" HorizontalContentAlignment="Left" FontSize="14" Click="BtnDashboard_Click"/>
                <Button Content="📦 Склад" Background="Transparent" Foreground="White" BorderThickness="0" Padding="20,15" HorizontalContentAlignment="Left" FontSize="14" Click="BtnStock_Click"/>
                <Button Content="🏪 Торговый зал" Background="Transparent" Foreground="White" BorderThickness="0" Padding="20,15" HorizontalContentAlignment="Left" FontSize="14" Click="BtnHall_Click"/>
                <Button Content="⚠️ Контроль сроков" Background="Transparent" Foreground="White" BorderThickness="0" Padding="20,15" HorizontalContentAlignment="Left" FontSize="14" Click="BtnExpiry_Click"/>

                <Separator Margin="20,10,20,10" Background="#555"/>

                <Button x:Name="BtnAdminHeader" Content="▼ Администрирование" Background="#1a1a1a" Foreground="White" BorderThickness="0" Padding="20,15" HorizontalContentAlignment="Left" FontSize="14" Click="BtnAdminHeader_Click"/>
                <StackPanel x:Name="AdminSubMenu" Background="#222" Visibility="Collapsed">
                    <Button Content="➕ Добавить товар" Background="Transparent" Foreground="#ccc" BorderThickness="0" Padding="35,10,20,10" HorizontalContentAlignment="Left" FontSize="13" Click="BtnAddProduct_Click"/>
                    <Button Content="📁 Категории" Background="Transparent" Foreground="#ccc" BorderThickness="0" Padding="35,10,20,10" HorizontalContentAlignment="Left" FontSize="13"/>
                </StackPanel>

                <Separator Margin="20,10,20,10" Background="#555"/>

                <Button Content="❓ Помощь" Background="Transparent" Foreground="White" BorderThickness="0" Padding="20,15" HorizontalContentAlignment="Left" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>