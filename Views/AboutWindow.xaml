<Window x:Class="StockImpulseX.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" 
        Height="420" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2c2c2c">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="📦 StockImpulse X" 
                   FontSize="24" FontWeight="Bold" Foreground="#ff6666" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Контент -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Программа для контроля товаров и их сроков годности в магазинах" 
                       FontSize="14" Foreground="#e0e0e0" TextWrapping="Wrap" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Возможности:" 
                       FontSize="14" FontWeight="Bold" Foreground="#ffaa44" 
                       Margin="0,10,0,5"/>

            <TextBlock Text="• Контроль сроков с подсветкой (красный/оранжевый)" 
                       FontSize="13" Foreground="#cccccc" Margin="15,2,0,2"/>
            <TextBlock Text="• Разделение Склад / Торговый зал" 
                       FontSize="13" Foreground="#cccccc" Margin="15,2,0,2"/>
            <TextBlock Text="• Поиск и фильтрация по срокам" 
                       FontSize="13" Foreground="#cccccc" Margin="15,2,0,2"/>
            <TextBlock Text="• Экспорт данных в CSV" 
                       FontSize="13" Foreground="#cccccc" Margin="15,2,0,2"/>
            <TextBlock Text="• Автообновление каждые 5 минут" 
                       FontSize="13" Foreground="#cccccc" Margin="15,2,0,2"/>

            <TextBlock Text="Разработчик:" 
                       FontSize="14" FontWeight="Bold" Foreground="#ffaa44" 
                       Margin="0,10,0,5"/>

            <TextBlock Text="MrKriTick" 
                       FontSize="13" Foreground="#cccccc" Margin="15,2,0,2"/>

            <TextBlock Text="Версия: 1.0" 
                       FontSize="12" Foreground="#888" 
                       HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>

        <!-- Ссылки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="🌐 GitHub" Click="GitHub_Click" 
                    Cursor="Hand" Background="#333" Foreground="#e0e0e0" 
                    BorderBrush="#555" Padding="15,8" Margin="0,0,10,0"/>
            <Button Content="🌐 Telegram" Click="Telegram_Click" 
                    Cursor="Hand" Background="#333" Foreground="#e0e0e0" 
                    BorderBrush="#555" Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>