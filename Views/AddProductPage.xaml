<Page x:Class="StockImpulseX.Views.AddProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление товара" 
      Background="#1a1a1a">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="➕ Добавление товара" 
                   FontSize="24" FontWeight="Bold" Foreground="#ff6666" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#1a1a1a">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
 
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Название товара *" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <TextBox x:Name="txtName" Padding="8" Margin="0,0,0,15" 
                             Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" CaretBrush="White"/>

                    <TextBlock Text="Категория *" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <ComboBox x:Name="cbCategory" Padding="6" Margin="0,0,0,15"
                              Background="#2c2c2c" Foreground="#2c2c2c" BorderBrush="#555">
                        <ComboBox.Resources>
                            <Style TargetType="Popup">
                                <Setter Property="AllowsTransparency" Value="True"/>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#2c2c2c"/>
                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#444"/>
                                        <Setter Property="Foreground" Value="#fff"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#fff"/>
                                        <Setter Property="Foreground" Value="#444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="Молочная продукция"/>
                        <ComboBoxItem Content="Мясная продукция"/>
                        <ComboBoxItem Content="Хлебобулочные изделия"/>
                        <ComboBoxItem Content="Овощи/Фрукты"/>
                        <ComboBoxItem Content="Напитки"/>
                        <ComboBoxItem Content="Кондитерские изделия"/>
                        <ComboBoxItem Content="Другое"/>
                    </ComboBox>

                    <TextBlock Text="Местоположение *" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <ComboBox x:Name="cbLocation" Padding="6" Margin="0,0,0,15"
                              Background="#2c2c2c" Foreground="#2c2c2c" BorderBrush="#555">
                        <ComboBox.Resources>
                            <Style TargetType="Popup">
                                <Setter Property="AllowsTransparency" Value="True"/>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#2c2c2c"/>
                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#444"/>
                                        <Setter Property="Foreground" Value="#fff"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#fff"/>
                                        <Setter Property="Foreground" Value="#444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="📦 Склад"/>
                        <ComboBoxItem Content="🏪 Торговый зал"/>
                    </ComboBox>

                    <TextBlock Text="Количество *" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <TextBox x:Name="txtQuantity" Padding="8" Margin="0,0,0,15" 
                             Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" CaretBrush="White"/>
                </StackPanel>
 
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="15,0,15,0">
                    <TextBlock Text="Дата производства *" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <DatePicker x:Name="dpManufactureDate" Padding="6" Margin="0,0,0,15"
                                Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555"
                                HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Дата годности *" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <DatePicker x:Name="dpExpiryDate" Padding="6" Margin="0,0,0,15"
                                Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555"
                                HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Штрих-код" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <TextBox x:Name="txtBarcode" Padding="8" Margin="0,0,0,15" 
                             Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" CaretBrush="White"/>

                    <TextBlock Text="Поставщик" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <TextBox x:Name="txtSupplier" Padding="8" Margin="0,0,0,15" 
                             Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" CaretBrush="White"/>
                </StackPanel>
 
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="15,0,0,0">
                    <TextBlock Text="Цена закупки (₽)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <TextBox x:Name="txtPurchasePrice" Padding="8" Margin="0,0,0,15" 
                             Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" CaretBrush="White"/>

                    <TextBlock Text="Цена продажи (₽)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <TextBox x:Name="txtSellingPrice" Padding="8" Margin="0,0,0,15" 
                             Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" CaretBrush="White"/>

                    <TextBlock Text="Номер партии" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <TextBox x:Name="txtBatchNumber" Padding="8" Margin="0,0,0,15" 
                             Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" CaretBrush="White"/>
                </StackPanel>
 
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0">
                    <TextBlock Text="Примечание" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#dddddd"/>
                    <TextBox x:Name="txtNote" Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                             Padding="10" VerticalScrollBarVisibility="Auto" 
                             Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" CaretBrush="White"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="BtnCancel_Click" 
                    Padding="15,8" Margin="0,0,10,0" FontSize="14" Cursor="Hand"
                    Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" BorderThickness="1"/>
            <Button Content="Сохранить" Click="BtnSave_Click" 
                    Padding="15,8" FontSize="14" Background="#8B0000" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>