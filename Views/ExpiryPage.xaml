<Page x:Class="StockImpulseX.Views.ExpiryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Контроль сроков годности" Background="#1a1a1a"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2c2c2c"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExpiryStatus}" Value="Critical">
                    <Setter Property="Background" Value="#8B0000"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExpiryStatus}" Value="Warning">
                    <Setter Property="Background" Value="#CC7000"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExpiryStatus}" Value="Expired">
                    <Setter Property="Background" Value="#4a0000"/>
                    <Setter Property="Foreground" Value="#ff8888"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExpiryStatus}" Value="Ok">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#333"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚠️ Контроль сроков годности" FontSize="24" FontWeight="Bold" Foreground="#ff6666" Margin="0,0,0,15"/>

        <!-- Фильтры -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock Text="Показать:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#aaaaaa" FontSize="13"/>
                <ComboBox x:Name="cbFilter" Width="160" SelectionChanged="CbFilter_SelectionChanged"
                          Background="#2c2c2c" Foreground="#2c2c2c" BorderBrush="#555">
                    <ComboBox.Resources>
                        <Style TargetType="Popup">
                            <Setter Property="AllowsTransparency" Value="True"/>
                        </Style>
                    </ComboBox.Resources>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#fff"/>
                            <Setter Property="Foreground" Value="#2c2c2c"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2c2c2c"/>
                                    <Setter Property="Foreground" Value="#fff"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#fff"/>
                                    <Setter Property="Foreground" Value="#2c2c2c"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBoxItem Content="Все товары" IsSelected="True"/>
                    <ComboBoxItem Content="🔴 Красные (1-3 дня)"/>
                    <ComboBoxItem Content="🟠 Оранжевые (4-7 дней)"/>
                    <ComboBoxItem Content="⚫ Просроченные"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0">
                <TextBox x:Name="txtSearch" Width="260" TextChanged="TxtSearch_TextChanged"
                         Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" CaretBrush="White"/>
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="18" Foreground="#888"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="📊 Экспорт" Click="BtnExport_Click" 
                        Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" BorderThickness="1" 
                        Padding="15,8" FontSize="13" Cursor="Hand" Height="35"/>
            </StackPanel>
        </Grid>

        <!-- Легенда -->
        <Border Grid.Row="2" Background="#252525" CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <Rectangle Width="14" Height="14" Fill="#8B0000" RadiusX="2" RadiusY="2" Margin="0,0,8,0"/>
                    <TextBlock Text="1-3 дня (критично)" Foreground="#cccccc" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <Rectangle Width="14" Height="14" Fill="#CC7000" RadiusX="2" RadiusY="2" Margin="0,0,8,0"/>
                    <TextBlock Text="4-7 дней (внимание)" Foreground="#cccccc" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <Rectangle Width="14" Height="14" Fill="#4a0000" RadiusX="2" RadiusY="2" Margin="0,0,8,0"/>
                    <TextBlock Text="Просрочено" Foreground="#cccccc" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="14" Height="14" Fill="White" Stroke="#555" RadiusX="2" RadiusY="2" Margin="0,0,8,0"/>
                    <TextBlock Text="> 7 дней (норма)" Foreground="#cccccc" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid x:Name="dgProducts" Grid.Row="3" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="#1a1a1a"
                  BorderBrush="#444"
                  FontSize="13"
                  RowHeight="32"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="Место" Binding="{Binding Location}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#ffaa44"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="Дата пр-ва" Binding="{Binding ManufactureDate, StringFormat='dd.MM.yyyy'}" Width="90"/>
                <DataGridTextColumn Header="Годен до" Binding="{Binding ExpiryDate, StringFormat='dd.MM.yyyy'}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дней" Binding="{Binding DaysUntilExpiry}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DaysUntilExpiry}" Value="0">
                                    <Setter Property="Foreground" Value="#ff8888"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DaysUntilExpiry}" Value="1">
                                    <Setter Property="Foreground" Value="#ff8888"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DaysUntilExpiry}" Value="2">
                                    <Setter Property="Foreground" Value="#ff8888"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DaysUntilExpiry}" Value="3">
                                    <Setter Property="Foreground" Value="#ff8888"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Действия" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑️" Click="BtnDelete_Click" 
                                    Background="Transparent" BorderThickness="0" 
                                    Cursor="Hand" Foreground="#ff8888" FontSize="16"
                                    Width="30" Height="28"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Пагинация -->
        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lblStats" Text="Записей: 0" VerticalAlignment="Center" FontSize="12" Foreground="#888"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnPrev" Content="&lt;" Width="35" Height="30" Click="BtnPrev_Click" Margin="0,0,5,0" 
                        FontSize="14" FontWeight="Bold" Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" BorderThickness="1" Cursor="Hand"/>
                <StackPanel x:Name="pnlPageNumbers" Orientation="Horizontal" Margin="5,0"/>
                <Button x:Name="btnNext" Content="&gt;" Width="35" Height="30" Click="BtnNext_Click" Margin="5,0,0,0" 
                        FontSize="14" FontWeight="Bold" Background="#2c2c2c" Foreground="#e0e0e0" BorderBrush="#555" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>